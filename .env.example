# Front na Vercel: URL do backend no Render (sem barra no final)
# VITE_API_URL=https://helena-ai.onrender.com

# Groq Cloud API Credentials
# Obtenha sua chave gratuitamente em https://console.groq.com/keys
VITE_GROQ_API_KEY=sua_chave_groq_aqui
GROQ_API_KEY=sua_chave_groq_aqui
VITE_GROQ_MODEL=openai/gpt-oss-120b

# Cakto (somente servidor — nunca prefixo VITE_)
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=

# Render: origens do front (Vercel + domínio .com.br), separadas por vírgula
# CORS_ORIGIN=https://helena.vercel.app,https://seudominio.com.br

# Evolution API (WhatsApp) — POST /message/sendText/{instance}
VITE_EVOLUTION_URL=http://localhost:8080
VITE_EVOLUTION_KEY=sua_global_api_key
VITE_EVOLUTION_INSTANCE=helena
