# ── Agora (divulgar, sem domínio e sem VPS) ──────────────────────────
# Front: Vercel (URL *.vercel.app)
# Back + WhatsApp: Render (URL *.onrender.com)
# Evolution API de verdade só entra quando você alugar a VPS.

# Front na Vercel — URL do Render, sem barra no final
VITE_API_URL=https://helena-ai.onrender.com

# Groq (Helena fala). Coloque a MESMA chave no build da Vercel e no Render.
VITE_GROQ_API_KEY=
GROQ_API_KEY=
VITE_GROQ_MODEL=openai/gpt-oss-120b

# Render
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=
CORS_ORIGIN=*
WHATSAPP_AUTH_DIR=data/whatsapp-auth
HELENA_AUTO_REPLY=true

# Cakto (servidor — webhook depois)
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=

# ── Evolution API ────────────────────────────────────────────────────
# Até a VPS: deixe EVOLUTION_URL vazio. O Render usa o WhatsApp nativo (QR).
# Com VPS: suba a Evolution lá e preencha:
# EVOLUTION_URL=https://evo.seudominio.com.br
# EVOLUTION_KEY=chave-global-da-evolution
# VITE_EVOLUTION_URL=https://evo.seudominio.com.br
# VITE_EVOLUTION_KEY=chave-global-da-evolution
VITE_EVOLUTION_INSTANCE=helena
EVOLUTION_INSTANCE=helena
EVOLUTION_URL=
EVOLUTION_KEY=
VITE_EVOLUTION_URL=
VITE_EVOLUTION_KEY=
