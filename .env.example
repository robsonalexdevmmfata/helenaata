# ── Produção ─────────────────────────────────────────────────────────
# Front: Vercel (URL *.vercel.app) — /api e /health são repassados ao Render (vercel.json)
# Back: Render (URL *.onrender.com) — repassa /api/evolution para a Evolution (Hostless)

# Deixe VAZIO na Vercel: o site chama /api no próprio domínio e a Vercel repassa ao Render.
# Só preencha se quiser chamar outro servidor direto (aí precisa estar em CORS_ORIGIN).
VITE_API_URL=
# Link que o time Dev envia ao cliente (site + cardápio)
VITE_PUBLIC_SITE_URL=https://helenaata.vercel.app
# Tokens do Time Dev: só em .env.local (nunca no Git, nunca com prefixo VITE_)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_NAME=Tecnologia da Informacao
GITHUB_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=helena
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

# Groq só no Render (GROQ_API_KEY). Nunca VITE_GROQ_API_KEY — isso entra no JS do navegador.
GROQ_API_KEY=
VITE_GROQ_MODEL=openai/gpt-oss-120b

# Render
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=
CORS_ORIGIN=https://helenaata.vercel.app,https://helenaata.onrender.com,http://localhost:8081
WHATSAPP_AUTH_DIR=data/whatsapp-auth
HELENA_AUTO_REPLY=true

# Cakto — webhook de pagamento pago:
# https://SEU-HOST/api/billing/cakto  (ex.: https://helenaata.onrender.com/api/billing/cakto)
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_WEBHOOK_SECRET=

# ── Evolution API (Hostless) ─────────────────────────────────────────
# URL pública, sem barra no final. A chave global NÃO vai no Git.
# No Render, copie EVOLUTION_URL e EVOLUTION_KEY iguais ao .env.local.
VITE_EVOLUTION_INSTANCE=helena
EVOLUTION_INSTANCE=helena
EVOLUTION_URL=https://evolutionapi.hostless.app
EVOLUTION_KEY=
VITE_EVOLUTION_URL=https://evolutionapi.hostless.app
# Nunca VITE_EVOLUTION_KEY — a chave fica só em EVOLUTION_KEY no Render.

# Supabase (Postgres do dono). Só em .env.local / painel do Render — senha com @ vira %40.
# O host db.REF.supabase.co é só IPv6 e o Render não conecta. Use o pooler de sessão (IPv4):
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_PROJECT_REF=
# SUPABASE_POOLER_REGION=us-east-1
# DATABASE_URL=postgresql://postgres.REF:SENHA_ENCODED@aws-0-us-east-1.pooler.supabase.com:5432/postgres
