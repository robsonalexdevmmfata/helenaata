# ── Agora (divulgar, sem domínio e sem VPS) ──────────────────────────
# Front: Vercel (URL *.vercel.app)
# Back + WhatsApp: Render (URL *.onrender.com)
# Evolution API de verdade só entra quando você alugar a VPS.

# Front na Vercel — URL do Render, sem barra no final
VITE_API_URL=https://helenaata.onrender.com
# Link que o time Dev envia ao cliente (site + cardápio)
VITE_PUBLIC_SITE_URL=https://helenaata.vercel.app
# Tokens do Time Dev: só em .env.local (nunca no Git, nunca com prefixo VITE_)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_NAME=Tecnologia da Informacao
GITHUB_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=helena
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

# Groq só no Render (GROQ_API_KEY). Nunca VITE_GROQ_API_KEY — isso entra no JS do navegador.
GROQ_API_KEY=
VITE_GROQ_MODEL=openai/gpt-oss-120b

# Render
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=
CORS_ORIGIN=https://helenaata.vercel.app,https://helenaata.onrender.com,http://localhost:8081
WHATSAPP_AUTH_DIR=data/whatsapp-auth
HELENA_AUTO_REPLY=true

# Cakto — webhook de pagamento pago:
# https://SEU-HOST/api/billing/cakto  (ex.: https://helenaata.onrender.com/api/billing/cakto)
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_WEBHOOK_SECRET=

# ── Evolution API (Hostless) ─────────────────────────────────────────
# URL pública, sem barra no final. A chave global NÃO vai no Git.
# No Render, copie EVOLUTION_URL e EVOLUTION_KEY iguais ao .env.local.
VITE_EVOLUTION_INSTANCE=hudemo
EVOLUTION_INSTANCE=hudemo
EVOLUTION_URL=https://evolutionapi.hostless.app
EVOLUTION_KEY=
VITE_EVOLUTION_URL=https://evolutionapi.hostless.app
# Nunca VITE_EVOLUTION_KEY — a chave fica só em EVOLUTION_KEY no Render.

# Supabase Postgres do dono. DATABASE_URL só em .env.local/servidor; senha com @ vira %40.
# Em produção, configure DATABASE_URL e SESSION_SECRET somente no ambiente do servidor.
# Não use prefixo VITE_ para credenciais ou strings de conexão.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_PROJECT_REF=
# DATABASE_URL=postgresql://postgres:SENHA_ENCODED@db.REF.supabase.co:5432/postgres
